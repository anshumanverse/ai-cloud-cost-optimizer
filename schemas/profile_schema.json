{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Profile Schema",
  "description": "Schema describing the extracted project profile from LLM.",

  "type": "object",
  "additionalProperties": false,

  "required": [
    "name",
    "description",
    "budget_inr_per_month",
    "tech_stack",
    "non_functional_requirements"
  ],

  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string",
      "minLength": 1
    },

    "budget_inr_per_month": {
      "type": "integer",
      "minimum": 0
    },

    "tech_stack": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "frontend":   { "type": ["string", "null"] },
        "backend":    { "type": ["string", "null"] },
        "database":   { "type": ["string", "null"] },
        "storage":    { "type": ["string", "null"] },
        "proxy":      { "type": ["string", "null"] },
        "hosting":    { "type": ["string", "null"] },
        "monitoring": { "type": ["string", "null"] },
        "analytics":  { "type": ["string", "null"] }
      },

      "required": [
        "frontend",
        "backend",
        "database",
        "storage",
        "proxy",
        "hosting",
        "monitoring",
        "analytics"
      ]
    },

    "non_functional_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": false
    }
  }
}
