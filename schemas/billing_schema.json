{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mock Billing Records",
  "description": "Schema for synthetic cloud billing entries generated by LLM.",
  "type": "array",
  "minItems": 1,

  "items": {
    "type": "object",
    "additionalProperties": false,

    "required": [
      "month",
      "service",
      "resource_id",
      "region",
      "usage_type",
      "usage_quantity",
      "unit",
      "cost_inr",
      "desc"
    ],

    "properties": {
      "month": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
      },

      "service": { "type": "string" },

      "resource_id": { "type": "string" },

      "region": { "type": "string" },

      "usage_type": { "type": "string" },

      "usage_quantity": {
        "type": "number",
        "minimum": 0
      },

      "unit": { "type": "string" },

      "cost_inr": {
        "type": "integer",
        "minimum": 0
      },

      "desc": { "type": "string" }
    }
  }
}
